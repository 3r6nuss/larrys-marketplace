# Use the same values on the main server and the Raspberry Pi.
PUBLIC_URL=https://larrys.example.com

# Managed PostgreSQL outside both application hosts.
DATABASE_URL=postgresql://larrys:replace-me@db.example.com:5432/larrys
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
DB_SSL_CA=
DB_CONNECT_TIMEOUT_MS=10000
DB_QUERY_TIMEOUT_MS=15000
DB_STATEMENT_TIMEOUT_MS=15000
DB_POOL_MAX=10

# Generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-one-random-secret-of-at-least-32-characters

# Cloudflare R2 or another S3-compatible object store.
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=larrys-images
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_PUBLIC_URL=https://media.example.com
S3_PREFIX=production
S3_FORCE_PATH_STYLE=false

# Existing upload volume on the main host; an empty volume is fine on the Pi.
UPLOADS_VOLUME=larrys_uploads

# Token of one remotely managed tunnel, shared by both connectors.
CLOUDFLARE_TUNNEL_TOKEN=replace-me

# Discord OAuth callback: PUBLIC_URL/api/auth/discord/callback
DISCORD_CLIENT_ID=replace-me
DISCORD_CLIENT_SECRET=replace-me
DISCORD_BOT_TOKEN=